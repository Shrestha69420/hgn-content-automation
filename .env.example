# Copy to .env.local and fill in. .env.local is gitignored; this file is the only place variables are documented.

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# Model IDs: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL_TEXT=gemini-3.8-flash
GEMINI_MODEL_RESEARCH=gemini-3.8-flash
GEMINI_MODEL_IMAGE=gemini-3.1-flash-lite-image

# --- Server ---
PORT=3000
# Public HTTPS URL of this server. Required only for Instagram publishing (Meta fetches images from it).
APP_URL=
SESSION_SECRET=
ALLOW_REGISTRATION=true
DEMO_PASSWORD=

# --- Publishing ---
# folder | instagram | both
PUBLISH_MODE=folder
# Where approved posts are written: <EXPORT_DIR>/<YYYY-MM-DD>_<title>/slide-01.png + caption.txt
EXPORT_DIR=./exports
# Instagram Graph API (own Business/Creator account, Meta app in development mode)
IG_USER_ID=
IG_ACCESS_TOKEN=
